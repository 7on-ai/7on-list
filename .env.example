# Neon Postgres — set automatically by Vercel's Neon integration
DATABASE_URL=
# Arcjet API key retrieved here: https://arcjet.com
ARCJET_KEY=
# Resend API key for the specs email: https://resend.com/api-keys
RESEND_API_KEY=
# Signing secret of the Resend webhook (whsec_…), for bounces and complaints
RESEND_WEBHOOK_SECRET=
# Any long random string; signs the links in emails (preferences, unsubscribe).
# Generate with: openssl rand -base64 32 — and never change it once emails are out.
EMAIL_LINK_SECRET=
# Optional — defaults shown
# EMAIL_FROM="7on <hello@7on.ai>"
# EMAIL_REPLY_TO=hello@7on.ai
